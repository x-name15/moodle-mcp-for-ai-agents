# Nombre descriptivo de la instancia (se muestra en logs y respuestas)
MOODLE_NAME="Moodle 4.x — Mi Instancia"

# Versión de Moodle instalada
MOODLE_VERSION="4.1"

# Ruta absoluta al directorio raíz de Moodle en el filesystem
# En WSL desde Windows: \\wsl.localhost\Ubuntu-24.04\home\user\moodle
# En Linux/Mac: /var/www/moodle
MOODLE_ROOT_PATH="/ruta/a/moodle"

# URL pública de la instancia
MOODLE_URL="http://localhost:8080"

# Base de datos MariaDB / MySQL
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="moodle"
DB_USER="user"
DB_PASSWORD="tu_password"

# RabbitMQ (si no lo usas, pon valores dummy — los tools de RabbitMQ fallarán gracefully)
RABBITMQ_HOST="localhost"
RABBITMQ_PORT="5672"
RABBITMQ_MANAGEMENT_PORT="15672"
RABBITMQ_USER="guest"
RABBITMQ_PASSWORD="guest"

# Ruta al JSON de microservicios de esta instancia (relativa a la raíz del proyecto)
MICROSERVICES_CONFIG="./data/microservices.miinstancia.json"
